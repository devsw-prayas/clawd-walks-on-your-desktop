{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/.vscode/tauri.conf.schema.json",
  "productName": "Clawd",
  "version": "3.1.0",
  "identifier": "com.clawd.pet",
  "build": {
    "frontendDist": "../renderer",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clawd",
        "width": 220,
        "height": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["../clawd.config.json"]
  }
}
